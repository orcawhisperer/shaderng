{
  "name": "shaderng",
  "version": "0.1.0",
  "description": "GPU shader components for Angular. Unofficial port of shadercn, with microphone-reactive [listen] drive.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "node tools/build-pages.mjs",
    "build:schematics": "node tools/build-schematics.mjs",
    "test:schematics": "npm run build:schematics && node --test \"dist/schematics/**/*.spec.js\"",
    "pack:schematics": "npm run build:schematics && npm pack ./dist/schematics --pack-destination dist",
    "generate:orbs": "node tools/generate-orbs.mjs"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0",
    "typegpu": "^0.12.5",
    "vgpu": "^0.4.1"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^22.0.1",
    "@angular-devkit/core": "^22.1.8",
    "@angular-devkit/schematics": "^22.1.8",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@babel/core": "^8.0.5",
    "@babel/preset-typescript": "^8.0.1",
    "@schematics/angular": "^22.1.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@webgpu/types": "^0.1.72",
    "jsdom": "^28.0.0",
    "jsonc-parser": "^3.3.1",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "unplugin-typegpu": "^0.12.3",
    "vitest": "^4.0.8"
  }
}
